# Nightly backup: write a new archive, restore-test it, then delete older ones
# (BACKUP_KEEP in .env). The app reads .env itself from WorkingDirectory.
[Unit]
Description=RHU Queue MongoDB backup
After=mongod.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/user/queue v2
ExecStart=/usr/bin/npm run backup -- --action=nightly
