# Adjust WorkingDirectory, EnvironmentFile and User to match where the app is installed.
[Unit]
Description=RHU Queue (Express API, realtime socket and React app)
After=network.target docker.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/home/user/queue-ts
EnvironmentFile=/home/user/queue-ts/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
