# RHU Queue (Express + React + MongoDB)

NODE_ENV=production
PORT=3080
BIND_ADDR=127.0.0.1

# MongoDB connection string, including the database name.
# With authentication: mongodb://USER:PASSWORD@127.0.0.1:27017/rhu_queue?authSource=admin
MONGO_URL=mongodb://127.0.0.1:27017/rhu_queue

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_LIFETIME=120
# Set to 1 when the site is only served over HTTPS.
SESSION_SECURE=0

# Set to 1 only when running behind your own reverse proxy (nginx), so the
# client IP is read from X-Forwarded-For.
TRUST_PROXY_HEADER=0

# Comma-separated origins allowed to open the realtime socket. Empty = any (LAN walls and kiosks).
ALLOWED_ORIGINS=

# Backups (mongodump archives). Keep this outside the web root.
BACKUP_DIR=./storage/backups
BACKUP_KEEP=7
# Optional second folder that receives a copy of each verified nightly backup.
BACKUP_COPY_DIR=

# Security layer. Detection logs only until SECURITY_ENFORCE=1.
SECURITY_DETECTION_ENABLED=1
SECURITY_ENFORCE=0
SECURITY_RATE_LIMIT_ENABLED=1
SECURITY_ALLOWLIST=127.0.0.1/8,::1
SECURITY_DENYLIST=
